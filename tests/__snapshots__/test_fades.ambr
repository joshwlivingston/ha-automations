  > sun(-8)
    INFO  set: ramp 33%; light.x 14% sun=-8.0° transition=60s
  > sun(-4)
    INFO  set: ramp 67%; light.x 29% sun=-4.0° transition=60s
  > manual(80)
  > sun(-3.9)
    INFO  keep: above target; light.x 80% target=30% sun=-3.9°
  > sun(-2)
    DEBUG skip: at or above target; light.x 80% target=39% sun=-2.0°
  > sun(0)
    DEBUG skip: at or above target; light.x 80% target=50% sun=0.0°
  > sun(0.5)
    DEBUG skip: at or above target; light.x 80% target=50% sun=0.5°
  > sun(1.5)
    INFO  ramp done: past to_level; sun=1.5° to_level=0°
  > sun(2)
    DEBUG skip: past to_level; sun=2.0° to_level=0°
  > sun(4.2)
    INFO  off: reached off_level; light.x sun=4.2° off_level=4° transition=300s
    INFO  disarm: reached off_level; until next start trigger
  > sun(6)
    DEBUG skip: not armed
  '''
