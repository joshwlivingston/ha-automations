# serializer version: 1
# name: test_off_time_log
  '''
  # sunset, light on after the fade
  > manual(50)
  > stop()
    INFO  off: reached off_time; light.x transition=300s
  > stop()
    INFO  skip: already off; light.x
  # sunrise, started
  > start()
    INFO  start: short of from_level; sun=-10.0deg to_level=0deg off_level=4deg
    INFO  set: ramp 0%; light.x 5% sun=-10.0deg transition=5s
  > stop()
    INFO  off: reached off_time; light.x transition=300s
    INFO  end: reached off_time; until next start trigger
  > sun(-4)
    DEBUG skip: waiting for start trigger
  '''
# ---
# name: test_restore_log
  '''
  > restore()
    INFO  resume: started before restart; ramp_from=-10deg
    INFO  set: ramp 70%; light.x 31% sun=-3.0deg transition=60s
  > sun(4.2)
    INFO  off: reached off_level; light.x sun=4.2deg off_level=4deg transition=300s
    INFO  end: reached off_level; until next start trigger
  > restore() # started too long ago
    INFO  skip resume: started too long ago; ramp_from=-10deg
    INFO  skip: waiting for start trigger
  > restore() # nothing saved
    INFO  skip resume: no saved fade
    INFO  skip: waiting for start trigger
  '''
# ---
# name: test_sunrise_dim_log
  '''
  > start()
    INFO  start: short of from_level; sun=-8.0deg to_level=0deg off_level=12deg
    INFO  set: ramp 0%; light.x 5% sun=-8.0deg transition=5s
  > sun(0)
    INFO  set: ramp 100%; light.x 50% sun=0.0deg transition=60s
  > sun(6)
    DEBUG skip: at or below target; light.x 50% target=50% sun=6.0deg
  > sun(11)
    INFO  set: dim 92%; light.x 46% sun=11.0deg transition=60s
  > manual(60)
  > sun(11.5)
    INFO  keep: raised by hand; light.x 60% target=46% sun=11.5deg
  > sun(12.1)
    INFO  off: reached off_level; light.x sun=12.1deg off_level=12deg transition=300s
    INFO  end: reached off_level; until next start trigger
  '''
# ---
# name: test_sunrise_morning_log
  '''
  > sun(-12)
    DEBUG skip: waiting for start trigger
  > start()
    INFO  start: short of from_level; sun=-12.0deg to_level=0deg off_level=4deg
    INFO  set: ramp 0%; light.x 5% sun=-12.0deg transition=5s
  > sun(-8)
    INFO  set: ramp 33%; light.x 14% sun=-8.0deg transition=60s
  > sun(-4)
    INFO  set: ramp 67%; light.x 29% sun=-4.0deg transition=60s
  > manual(80)
  > sun(-3.9)
    INFO  keep: above target; light.x 80% target=30% sun=-3.9deg
  > sun(-2)
    DEBUG skip: at or above target; light.x 80% target=39% sun=-2.0deg
  > sun(0)
    DEBUG skip: at or above target; light.x 80% target=50% sun=0.0deg
  > sun(0.5)
    DEBUG skip: at or above target; light.x 80% target=50% sun=0.5deg
  > sun(1.5)
    INFO  ramp done: past to_level; sun=1.5deg to_level=0deg
  > sun(2)
    DEBUG skip: past to_level; sun=2.0deg to_level=0deg
  > sun(4.2)
    INFO  off: reached off_level; light.x sun=4.2deg off_level=4deg transition=300s
    INFO  end: reached off_level; until next start trigger
  > sun(6)
    DEBUG skip: waiting for start trigger
  '''
# ---
# name: test_sunrise_start_skip_log
  '''
  # sun at -2, rising=True
  > start()
    INFO  skip start: past from_level; sun=-2.0deg from_level=-6deg
  # sun at -10, rising=False
  > start()
    INFO  skip start: sun falling; sun=-10.0deg
  # sun at None, rising=None
  > start()
    INFO  skip start: no sun reading
  '''
# ---
# name: test_sunset_evening_log
  '''
  > start()
    INFO  skip: sun rising; sun=12.0deg
  > sun(12, rising=False)
    DEBUG skip: short of ramp_from; sun=12.0deg ramp_from=6deg
  > sun(6)
    INFO  set: ramp 0%; light.x 5% sun=6.0deg transition=60s
  > sun(0)
    INFO  set: ramp 50%; light.x 21% sun=0.0deg transition=60s
  > sun(-6)
    INFO  set: ramp 100%; light.x 50% sun=-6.0deg transition=60s
  > sun(-6.5)
    DEBUG skip: at or above target; light.x 50% target=50% sun=-6.5deg
  > sun(-8)
    INFO  ramp done: past to_level; sun=-8.0deg to_level=-6deg
  '''
# ---
